# lexwatch configuration. Copy to .env and fill in. Never commit real values.
# Every variable is read by src/lexwatch/config.py; empty means "use the default".

# --- general ---------------------------------------------------------------------------
# development | test | production (production refuses DEV_AUTH, SCORER=fake and an empty SECRET_KEY)
ENV=production
LOG_LEVEL=INFO
# Public URL of the app (email links, default OIDC redirect URI)
BASE_URL=https://lexwatch.example.internal
# Long random string; signs the session cookie (e.g. `python -c "import secrets;print(secrets.token_urlsafe(48))"`)
SECRET_KEY=
# Secure cookie flag; forced on when ENV=production
SESSION_HTTPS_ONLY=true
# fr | en
DEFAULT_LANGUAGE=fr

# --- database --------------------------------------------------------------------------
# docker compose builds DATABASE_URL from these; set DATABASE_URL yourself outside compose
POSTGRES_USER=lexwatch
POSTGRES_PASSWORD=
POSTGRES_DB=lexwatch
# DATABASE_URL=postgresql+psycopg://lexwatch:<password>@db:5432/lexwatch
APP_PORT=8000

# --- authentication (OIDC: Entra ID or Keycloak) ----------------------------------------
# Dev only: log in a fixed local user without OIDC. Refused when ENV=production.
DEV_AUTH=false
# Role of the DEV_AUTH user: admin | user
DEV_AUTH_ROLE=admin
# Discovery: ${OIDC_ISSUER}/.well-known/openid-configuration (fetched through HTTPS_PROXY)
# Entra ID: https://login.microsoftonline.com/<tenant-id>/v2.0 (a tenant id, not "common")
# Keycloak: https://<host>/realms/<realm>
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Default: ${BASE_URL}/auth/callback
OIDC_REDIRECT_URI=
OIDC_SCOPES=openid email profile
# Claim holding the user's roles or groups, list or string. Dotted paths reach nested claims.
# Entra ID: roles (app roles) or groups (object ids). Keycloak: realm_access.roles,
# resource_access.<client-id>.roles or groups. Read from the ID token, then the userinfo
# endpoint, then the access token (Keycloak puts realm_access only there by default).
OIDC_ROLE_CLAIM=roles
# Value(s) in OIDC_ROLE_CLAIM that grant the admin role, comma-separated (everyone else is a
# user). For Entra ID groups, use the group object id.
OIDC_ADMIN_VALUE=lexwatch-admin
# Sign out at the provider too (RP-initiated logout) when it has an end_session_endpoint
OIDC_END_SESSION=true

# --- sources and outbound HTTP ----------------------------------------------------------
HTTP_USER_AGENT=lexwatch/0.1 (+internal bill tracker; contact: it@example.internal)
HTTP_TIMEOUT_SECONDS=30
DATAPUBLIC_API_URL=https://data.public.lu/api/1/
# Seconds between two requests to data.public.lu (one request at a time)
DATAPUBLIC_REQUEST_DELAY_SECONDS=1
# Daily delta (plenary votes, dataset 109 on data.public.lu; chd.lu pages are never scraped).
# Set false to rely on datasets 112/121 only.
CHD_ENABLED=true
CHD_REQUEST_DELAY_SECONDS=2
# Outbound proxy (honoured by httpx and azure-identity)
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,db

# --- scoring ---------------------------------------------------------------------------
# foundry | local | fake (fake = keyword overlap, for development only; refused when ENV=production)
SCORER=foundry
# Default profile threshold (0..1); profiles can override it. Leave empty to use the scorer's
# own default: foundry Rerank 5 Pro 0.5, Rerank 5 Fast 0.45, Rerank 4 0.5 (uncalibrated),
# local 0.05 (calibrated on real bills), fake 0.3. Set it to force one value for every scorer.
DEFAULT_THRESHOLD=
# Max characters of bill text sent to the scorer
SCORING_MAX_CHARS=4000
# Foundry rerank endpoint: https://<resource>.services.ai.azure.com/providers/cohere/v2/rerank
# A bare resource root (https://<resource>.services.ai.azure.com) gets that path appended.
# Point it at a Data Zone (EU) deployment's resource if your policy requires it.
FOUNDRY_ENDPOINT=
# Deployment/model name, e.g. Cohere-rerank-v5-fast | Cohere-rerank-v5-pro | Cohere-rerank-v4.0-fast
FOUNDRY_MODEL=Cohere-rerank-v5-fast
# API key auth; leave empty to use Entra ID (managed identity / service principal below)
FOUNDRY_API_KEY=
# Header carrying the key: Authorization (sent as "Bearer <key>") or api-key (raw key)
FOUNDRY_API_KEY_HEADER=Authorization
# Entra ID token scope; alternative: https://ai.azure.com/.default (see docs/research/foundry-rerank.md)
FOUNDRY_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
FOUNDRY_TIMEOUT_SECONDS=30
FOUNDRY_MAX_RETRIES=4
FOUNDRY_MAX_DOCUMENTS=100
# Per-document token cap sent as max_tokens_per_doc; 0 = omit (server default 4096)
FOUNDRY_MAX_TOKENS_PER_DOC=0
# Consecutive failed requests (after retries) that stop scoring for the rest of the run
FOUNDRY_CIRCUIT_THRESHOLD=3
# Entra ID service principal for azure-identity (omit when using a managed identity)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Optional local scorer (docker compose profile local-scorer)
INSTALL_LOCAL_SCORER=0
LOCAL_MODEL_DIR=/models/bge-reranker-v2-m3
LOCAL_MODEL_REPO=onnx-community/bge-reranker-v2-m3-ONNX
# Pinned Hugging Face revision and file (int8 single-file ONNX, ~571 MB)
LOCAL_MODEL_REVISION=6f5ff65298512715a1e669753bc754d2bc8f367b
LOCAL_MODEL_FILE=onnx/model_int8.onnx
# Tokens per (rule, bill) pair and pairs per ONNX batch
LOCAL_MAX_LENGTH=512
LOCAL_BATCH_SIZE=8

# --- email (SMTP relay) ----------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS on a plain connection (port 587) or implicit TLS (port 465): pick one
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=lexwatch@example.internal
SMTP_TIMEOUT_SECONDS=30
DIGEST_ENABLED=true

# --- worker ----------------------------------------------------------------------------
# Daily job time, HH:MM in APP_TIMEZONE
DAILY_JOB_TIME=06:30
APP_TIMEZONE=Europe/Luxembourg
WORKER_POLL_SECONDS=15
